{
  "name": "@lucky-day/workspace",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.3.13"
  },
  "packageManager": "bun@1.3.13",
  "workspaces": {
    "packages": [
      "packages/ui/*",
      "apps/*"
    ],
    "catalog": {
      "@emotion/cache": "^11.14.0",
      "@emotion/react": "^11.14.0",
      "@emotion/server": "^11.11.0",
      "@emotion/styled": "^11.14.1",
      "@griffel/react": "^1.7.2",
      "@mui/icons-material": "^9.1.1",
      "@mui/material-nextjs": "^9.1.1",
      "@mui/material": "^9.1.1",
      "@types/bun": "latest",
      "@types/react-dom": "latest",
      "@types/react": "19.2.17",
      "@typescript/native-preview": "7.0.0-dev.20260616.1",
      "babel-plugin-react-compiler": "1.0.0",
      "happy-dom": "~20.10.4",
      "jose": "^6.2.3",
      "next": "16.2.9",
      "react-dom": "19.2.7",
      "react": "19.2.7",
      "server-only": "^0.0.1",
      "swr": "^2.4.1",
      "typescript": "npm:@typescript/native-preview@7.0.0-dev.20260421.2",
      "vite-plus": "0.1.24",
      "vite": "npm:@voidzero-dev/vite-plus-core@0.1.24",
      "vitest": "npm:@voidzero-dev/vite-plus-test@0.1.24",
      "zod": "^4.4.3"
    }
  },
  "scripts": {
    "clean": "bunx rimraf dist  node_modules bun.lock; bun run --filter '*' clean",
    "setup": "bun run clean; bun install",
    "ready": "vp fmt && vp lint && vp run test -r && vp run build -r",
    "dev": "vpr web#dev",
    "prepare": "vp config"
  },
  "devDependencies": {
    "vite-plus": "catalog:"
  },
  "overrides": {
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
